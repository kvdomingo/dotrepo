{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "litellm": {
      "name": "LiteLLM",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://litellm.lab.kvd.studio/v1"
      },
      "models": {
        "gpt-6.1-sol": {
          "name": "GPT-6.1 Sol"
        },
        "gpt-6-luna": {
          "name": "GPT-6 Luna"
        },
        "claude-opus-5-5": {
          "name": "Claude Opus 5.5"
        },
        "claude-sonnet-5-5": {
          "name": "Claude Sonnet 5.5"
        },
        "gemini-4-argon": {
          "name": "Gemini 4 Argon",
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        },
        "gemini-3.8-flash": {
          "name": "Gemini 3.8 Flash",
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        },
        "gemini-3.1-pro-preview": {
          "name": "Gemini 3.1 Pro Preview"
        }
      }
    },
    "ollama": {
      "name": "Ollama (local)",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://localhost:11434/v1",
      },
      "models": {
        "qwen3-coder:30b-24k": {
          "name": "Qwen3-Coder",
          "tool_call": true
        },
        "gpt-oss:latest": {
          "name": "GPT OSS",
          "tool_call": true
        },
        "mistral-nemo:latest": {
          "name": "Mistral NeMo",
          "tool_call": true
        }
      }
    },
    "lmstudio": {
      "name": "LMStudio",
      "options": {
        "baseURL": "http://localhost:1234/v1"
      },
      "models": {
        "google/gemma-4-26b-a4b": {
          "name": "Gemma 4",
          "tool_call": true
        },
        "qwen3.5-27b-claude-4.6-opus-reasoning-distilled": {
          "name": "Qwen3.5-Claude 4.6 Opus Reasoning Distilled",
          "tool_call": true
        }
      }
    }
  },
  "permission": {
    "*": "ask",
    "skill": {
      "*": "allow"
    }
  },
  "plugin": [
    "@tarquinen/opencode-dcp@latest",
    "envsitter-guard@latest",
    "opencode-agent-memory@latest",
    "opencode-agent-skills@latest",
    "opencode-wakatime@latest"
  ]
}
