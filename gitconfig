[user]
	name = Kenneth V. Domingo
	email = hello@kvd.studio
[includeIf "gitdir:~/eyva/"]
    path = ~/eyva/.gitconfig
[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[safe]
	directory = *
[core]
  editor = nvim
  excludesfile = ~/.gitignore
  pager = delta
[column]
  ui = auto
[init]
  defaultBranch = main
[branch]
  sort = -committerdate
[tag]
  sort = version:refname
[commit]
  verbose = true
[rerere]
  enabled = true
  autoupdate = true
[push]
  default = simple
  autoSetupRemote = true
  followTags = true
[pull]
  rebase = true
[rebase]
  autoSquash = true
  autoStash = true
  updateRefs = true
[fetch]
  prune = true
  pruneTags = true
  all = true
[merge]
  conflictstyle = zdiff3
[diff]
  algorithm = histogram
  colorMoved = plain
  mnemonicPrefix = true
  renames = true
[interactive]
  diffFilter = delta --color-only
[alias]
	snap = !git commit -m \"snapshot $(date --rfc-3339 seconds)\"
	amend = commit --amend
	just-amend = commit --amend --no-edit
  sign = commit --amend -s --no-edit
	tree = log --graph --abbrev-commit --decorate
	tree-all = log --graph --abbrev-commit --decorate
[credential]
	helper = 
	helper = libsecret
	credentialStore = gpg
[credential "https://git.lab.kvd.studio"]
	provider = generic
[pager]
	branch = false
[delta]
  navigate = true
[help]
  autocorrect = prompt
[lfs "customtransfer.xet"]
  path = git-xet
  args = transfer
  concurrent = true
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
